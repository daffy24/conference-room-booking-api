{
  "info": {
    "_postman_id": "1206b83f-4908-4c67-ac9d-cf4dca3c8581",
    "name": "Conference Booking · Reports",
    "description": "Read-only business reports. Select the Local environment, set report_from and report_to (inclusive Kyiv dates, YYYY-MM-DD, at most 366 days), and authorize this collection as booking-admin. Enable the optional roomId query parameter to filter one room. Tokens and passwords are not included.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "oauth2",
    "oauth2": [
      {
        "key": "tokenName",
        "value": "Conference Booking · Reports",
        "type": "string"
      },
      {
        "key": "grant_type",
        "value": "authorization_code_with_pkce",
        "type": "string"
      },
      {
        "key": "challengeAlgorithm",
        "value": "S256",
        "type": "string"
      },
      {
        "key": "useBrowser",
        "value": true,
        "type": "boolean"
      },
      {
        "key": "authUrl",
        "value": "{{authority}}/protocol/openid-connect/auth?prompt=login",
        "type": "string"
      },
      {
        "key": "accessTokenUrl",
        "value": "{{authority}}/protocol/openid-connect/token",
        "type": "string"
      },
      {
        "key": "refreshTokenUrl",
        "value": "{{authority}}/protocol/openid-connect/token",
        "type": "string"
      },
      {
        "key": "clientId",
        "value": "{{client_id}}",
        "type": "string"
      },
      {
        "key": "redirect_uri",
        "value": "{{callback_url}}",
        "type": "string"
      },
      {
        "key": "scope",
        "value": "openid",
        "type": "string"
      },
      {
        "key": "state",
        "value": "{{$guid}}",
        "type": "string"
      },
      {
        "key": "client_authentication",
        "value": "body",
        "type": "string"
      },
      {
        "key": "addTokenTo",
        "value": "header",
        "type": "string"
      },
      {
        "key": "headerPrefix",
        "value": "Bearer",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "report_from",
      "value": "",
      "type": "string",
      "description": "First Kyiv date, YYYY-MM-DD."
    },
    {
      "key": "report_to",
      "value": "",
      "type": "string",
      "description": "Last Kyiv date, YYYY-MM-DD."
    },
    {
      "key": "room_id",
      "value": "",
      "type": "string",
      "description": "Optional room identifier; enable the roomId query parameter to use it."
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "for (const name of ['report_from', 'report_to']) {",
          "  if (!/^\\d{4}-\\d{2}-\\d{2}$/.test(pm.variables.get(name) || '')) {",
          "    throw new Error(`Set ${name} to a date in YYYY-MM-DD format in collection variables.`);",
          "  }",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Booked revenue by day",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/reports/revenue?from={{report_from}}&to={{report_to}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "reports",
            "revenue"
          ],
          "query": [
            {
              "key": "from",
              "value": "{{report_from}}"
            },
            {
              "key": "to",
              "value": "{{report_to}}"
            },
            {
              "key": "roomId",
              "value": "{{room_id}}",
              "disabled": true
            }
          ]
        },
        "description": "Returns confirmed booking values, including future bookings, not received payments."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Administrator receives a report', () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) {",
              "  const report = pm.response.json();",
              "  pm.test('Daily series uses UAH and Kyiv dates', () => { pm.expect(report.currency).to.eql('UAH'); pm.expect(report.timeZone).to.eql('Europe/Kyiv'); pm.expect(report.days).to.be.an('array'); });",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "Room performance",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/reports/rooms?from={{report_from}}&to={{report_to}}&page=1&pageSize=20",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "reports",
            "rooms"
          ],
          "query": [
            {
              "key": "from",
              "value": "{{report_from}}"
            },
            {
              "key": "to",
              "value": "{{report_to}}"
            },
            {
              "key": "roomId",
              "value": "{{room_id}}",
              "disabled": true
            },
            {
              "key": "page",
              "value": "1"
            },
            {
              "key": "pageSize",
              "value": "20"
            }
          ]
        },
        "description": "Ranks rooms by booked revenue; includes active rooms with zero bookings."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Administrator receives a report', () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) {",
              "  const report = pm.response.json();",
              "  pm.test('Result is paginated', () => { pm.expect(report.items).to.be.an('array'); pm.expect(report.totalCount).to.be.at.least(0); });",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "Service popularity",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/reports/services?from={{report_from}}&to={{report_to}}&page=1&pageSize=20",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "reports",
            "services"
          ],
          "query": [
            {
              "key": "from",
              "value": "{{report_from}}"
            },
            {
              "key": "to",
              "value": "{{report_to}}"
            },
            {
              "key": "roomId",
              "value": "{{room_id}}",
              "disabled": true
            },
            {
              "key": "page",
              "value": "1"
            },
            {
              "key": "pageSize",
              "value": "20"
            }
          ]
        },
        "description": "Ranks service snapshots by booking count, then booked value; retains removed services."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Administrator receives a report', () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) {",
              "  const report = pm.response.json();",
              "  pm.test('Result is paginated', () => { pm.expect(report.items).to.be.an('array'); pm.expect(report.totalCount).to.be.at.least(0); });",
              "}"
            ]
          }
        }
      ]
    }
  ]
}
