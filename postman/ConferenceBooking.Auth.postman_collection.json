{
  "info": {
    "_postman_id": "392e125b-2d7b-4d54-b310-5df26e85d965",
    "name": "Conference Booking · Authentication",
    "description": "Local Keycloak authentication checks. Import Conference Booking · Local. In the collection Authorization tab, select Get New Access Token, sign in through the browser and select Use Token. Then send requests or run the collection. Application users: booking-customer (DEMO_CUSTOMER_PASSWORD in .env) and booking-admin (DEMO_ADMIN_PASSWORD). Enter passwords only on the Keycloak page. Obtain a new token to switch users. See postman/README.md; business endpoint schemas are available in Swagger.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "oauth2",
    "oauth2": [
      { "key": "tokenName", "value": "Conference Booking · Local", "type": "string" },
      { "key": "grant_type", "value": "authorization_code_with_pkce", "type": "string" },
      { "key": "challengeAlgorithm", "value": "S256", "type": "string" },
      { "key": "useBrowser", "value": true, "type": "boolean" },
      { "key": "authUrl", "value": "{{authority}}/protocol/openid-connect/auth?prompt=login", "type": "string" },
      { "key": "accessTokenUrl", "value": "{{authority}}/protocol/openid-connect/token", "type": "string" },
      { "key": "refreshTokenUrl", "value": "{{authority}}/protocol/openid-connect/token", "type": "string" },
      { "key": "clientId", "value": "{{client_id}}", "type": "string" },
      { "key": "redirect_uri", "value": "{{callback_url}}", "type": "string" },
      { "key": "scope", "value": "openid", "type": "string" },
      { "key": "state", "value": "{{$guid}}", "type": "string" },
      { "key": "client_authentication", "value": "body", "type": "string" },
      { "key": "addTokenTo", "value": "header", "type": "string" },
      { "key": "headerPrefix", "value": "Bearer", "type": "string" }
    ]
  },
  "item": [
    {
      "name": "01 · Health",
      "description": "Public service health checks.",
      "item": [
        {
          "name": "API is alive · 200",
          "request": {
            "method": "GET",
            "auth": { "type": "noauth" },
            "url": "{{base_url}}/health/live",
            "description": "Checks whether the API process responds, independently of database availability."
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('API is alive', () => pm.response.to.have.status(200));",
            "pm.test('Health response is Healthy', () => pm.expect(pm.response.text()).to.eql('Healthy'));"
          ] } }]
        },
        {
          "name": "Database is ready · 200",
          "request": {
            "method": "GET",
            "auth": { "type": "noauth" },
            "url": "{{base_url}}/health/ready",
            "description": "Checks the API connection to PostgreSQL. Returns 503 while the database is unavailable."
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Database is ready', () => pm.response.to.have.status(200));",
            "pm.test('Health response is Healthy', () => pm.expect(pm.response.text()).to.eql('Healthy'));"
          ] } }]
        }
      ]
    },
    {
      "name": "02 · Identity",
      "description": "Uses the collection authorization token. Sign in with Get New Access Token, then select Use Token.",
      "item": [
        {
          "name": "Current user · 200",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/identity/me",
            "description": "Returns id, username and roles from the validated token. Expects Customer for booking-customer and Admin for booking-admin. This request verifies authentication and claims; business endpoint authorization is covered by the xUnit integration suite."
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Authenticated request succeeds', () => pm.response.to.have.status(200));",
            "pm.test('Identity contains a subject and username', () => {",
            "  const user = pm.response.json();",
            "  pm.expect(user.id).to.be.a('string').and.not.empty;",
            "  pm.expect(user.username).to.be.a('string').and.not.empty;",
            "  pm.expect(user.roles).to.be.an('array');",
            "});",
            "pm.test('Demo user has the assigned application role', () => {",
            "  const user = pm.response.json();",
            "  const expectedRoles = { 'booking-customer': 'Customer', 'booking-admin': 'Admin' };",
            "  pm.expect(user.username).to.be.oneOf(Object.keys(expectedRoles));",
            "  pm.expect(user.roles).to.include(expectedRoles[user.username]);",
            "});"
          ] } }]
        }
      ]
    },
    {
      "name": "03 · Rejected requests",
      "description": "Negative checks. These requests explicitly override collection authorization.",
      "item": [
        {
          "name": "No token · 401",
          "request": {
            "method": "GET",
            "auth": { "type": "noauth" },
            "url": "{{base_url}}/api/identity/me",
            "description": "Omits the Authorization header even when the collection has a selected token."
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Missing token is rejected', () => pm.response.to.have.status(401));",
            "pm.test('API sends a Bearer challenge', () => pm.expect(pm.response.headers.get('WWW-Authenticate')).to.match(/^Bearer/i));"
          ] } }]
        },
        {
          "name": "Invalid token · 401",
          "request": {
            "method": "GET",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "invalid-token", "type": "string" }] },
            "url": "{{base_url}}/api/identity/me",
            "description": "Sends a deliberately invalid bearer token. The real collection token is retained."
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Invalid token is rejected', () => pm.response.to.have.status(401));",
            "pm.test('API sends a Bearer challenge', () => pm.expect(pm.response.headers.get('WWW-Authenticate')).to.match(/^Bearer/i));",
            "pm.test('Validation details are not exposed', () => {",
            "  pm.expect(pm.response.text()).not.to.include('IDX');",
            "  pm.expect(pm.response.headers.get('WWW-Authenticate')).not.to.include('error_description');",
            "});"
          ] } }]
        }
      ]
    },
    {
      "name": "04 · Keycloak",
      "item": [
        {
          "name": "OpenID Connect discovery · 200",
          "request": {
            "method": "GET",
            "auth": { "type": "noauth" },
            "url": "{{authority}}/.well-known/openid-configuration",
            "description": "Public Keycloak endpoints, issuer and supported authentication capabilities."
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Discovery is available', () => pm.response.to.have.status(200));",
            "pm.test('Issuer matches the environment', () => pm.expect(pm.response.json().issuer).to.eql(pm.environment.get('authority')));",
            "pm.test('PKCE with S256 is supported', () => pm.expect(pm.response.json().code_challenge_methods_supported).to.include('S256'));"
          ] } }]
        }
      ]
    }
  ]
}
