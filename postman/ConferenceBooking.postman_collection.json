{
  "info": {
    "_postman_id": "392e125b-2d7b-4d54-b310-5df26e85d965",
    "name": "Conference Booking",
    "description": "Authentication, room management, availability, bookings and administrator reports in one collection. Import the Local environment. In collection Authorization, choose Get New Access Token, sign in as booking-admin and select Use Token. Run folders in order for a complete scenario, or send requests manually. IDs are saved automatically. Blank dates default to tomorrow; edit collection variables to use another period. Each complete run creates a new demo room and future booking. Room deletion uses a separate unbooked room; the booked room remains because cancellation is not implemented. Passwords belong on the Keycloak login page only. See postman/README.md.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
