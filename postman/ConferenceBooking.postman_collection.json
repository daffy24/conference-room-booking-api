      "key": "starts_at",
      "value": "",
      "type": "string",
      "description": "Booking and availability start, ISO 8601 with Z or an explicit offset. Blank defaults to tomorrow at 08:00 UTC (10:00 or 11:00 in Kyiv). Clear to regenerate."
    },
    {
      "key": "duration_minutes",
      "value": "240",
      "type": "string",
      "description": "Booking and availability duration in minutes. Must fit within one Kyiv day, 06:00–23:00."
    },
    {
      "key": "room_id",
      "value": "",
      "type": "string",
      "description": "Saved by Create room. Used for reads, updates, availability checks, bookings and optional report filtering."
    },
