    {
      "name": "06 · Room deletion",
      "description": "Admin only. Creates a separate unbooked room to demonstrate deletion. The room used for the booking remains: deleting a room with a future or ongoing booking returns 409, and cancellation is outside the current API.",
      "item": [
        {
          "name": "Create unbooked room for deletion · 201",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/rooms",
            "description": "Creates a disposable room and saves delete_room_id. Does not overwrite room_id or affect the booking/report scenario.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman deletion {{$guid}}\",\n  \"capacity\": 10,\n  \"baseHourlyRate\": 1000,\n  \"services\": []\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('delete_room_id', '');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "if (pm.response.code === 201) {",
                  "  pm.collectionVariables.set('delete_room_id', pm.response.json().id);",
                  "  pm.test('Separate room ID is saved', () => {",
                  "    pm.expect(pm.collectionVariables.get('delete_room_id')).to.be.a('string').and.not.empty;",
                  "    pm.expect(pm.collectionVariables.get('delete_room_id')).not.to.eql(pm.variables.get('room_id'));",
                  "  });",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete unbooked room · 204",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{base_url}}/api/rooms/{{delete_room_id}}",
            "description": "Admin. Soft-deletes only the room saved by the preceding request. Repeating deletion returns 404."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
